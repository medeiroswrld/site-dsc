# Copie este arquivo para .env.local e preencha com as chaves do seu projeto.
# Supabase › Settings › API
#
# .env.local NUNCA deve ir para o Git.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon public" — pode aparecer no navegador, o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — acesso total ao banco. Só no servidor.
# Nunca coloque esta chave numa variável que comece com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Estoque ao vivo do CRM (Amply). O endereco do feed da loja, com o token.
# AUSENTE = o site le so o banco dele, exatamente como antes de existir feed.
# Apagar esta variavel e o jeito de reverter sem deploy.
CRM_FEED_URL=
